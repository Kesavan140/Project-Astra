# SEO-friendly URLs — Apache mod_rewrite
# Maps /about → about.html (works alongside .html links for local dev)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical redirect: /page.html → /page
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # Serve .html files for clean URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(about|services|industries|portfolio|careers|contact)/?$ $1.html [L,NC]

  # Home
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Compression & caching
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
